# Local dev uses SQLite by default — no setup needed. Copy to .env to override.
DATABASE_URL=sqlite:///./grocery.db
# For Postgres (Docker / PaaS):
# DATABASE_URL=postgresql+psycopg2://grocery:grocery@db:5432/grocery

DEFAULT_PLZ=10115
CORS_ORIGINS=*

# Root log level (DEBUG/INFO/WARNING/...). Scraper/locator failures log a warning.
LOG_LEVEL=INFO
# Optional: enable Sentry error tracking by setting a DSN (no-op when unset).
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# Optional: when set, POST /api/reset and /api/recategorize require this token
# (sent as an X-Admin-Token header). Leave unset for open local dev.
# ADMIN_TOKEN=change-me

# Optional: let a FAILED scrape serve hardcoded sample offers instead of nothing.
#
# Off by default so production never publishes invented prices — sample offers carry made-up
# amounts and plausible validity windows, and nothing downstream (Basket totals, Compare, the
# price-history collector) can tell them from real deals. A missing chain is visible; a fake
# 1,59 € shampoo is not.
#
# Turn it on locally if you want the app populated without a working upstream.
# SCRAPE_SAMPLE_FALLBACK=true
